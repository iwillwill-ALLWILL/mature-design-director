{
  "schema_version": 4,
  "skill": "mature-design-director",
  "authority": {
    "owns": [
      "final-user-intent",
      "art-direction",
      "cross-medium-coherence",
      "creative-foundation-selection",
      "whole-artifact-critique",
      "design-learning"
    ],
    "delegates": [
      "file-format-mechanics",
      "runtime-and-engine-mechanics",
      "tool-specific-editing",
      "rendering-and-encoding"
    ],
    "composition_rule": "final-audience-first-creative-foundation-before-mechanics-capabilities-as-needed",
    "release_evidence": [
      "audience-authenticity",
      "creative-source",
      "representative-proof",
      "proof-selection",
      "comparative-quality",
      "source-truth",
      "working-artifact",
      "rendered-artifact",
      "native-context",
      "independent-critique",
      "delivery-verification"
    ],
    "distinct_evidence_sets": [
      [
        "creative-source",
        "representative-proof",
        "proof-selection",
        "rendered-artifact",
        "comparative-quality",
        "independent-critique",
        "delivery-verification"
      ]
    ]
  },
  "layer_contract": {
    "creative_foundation": "Owns the dominant visible or audible language through an approved product system, artboard, reference set, real or licensed media, authored asset system, or an explicitly selected creative source.",
    "assembly_mechanics": "Owns implementation, layout execution, runtime behavior, file structure, rendering, export, encoding, and packaging without inventing the creative direction.",
    "separation_rule": "A generator, code framework, layout script, export library, renderer, or engine is assembly mechanics unless the requested medium itself is creative coding. Mechanics cannot be recorded as the creative foundation merely because they produced valid files."
  },
  "artifact_lifecycle": {
    "initial_state": "direction-candidate",
    "states": {
      "direction-candidate": {"terminal": false, "user_facing_label": "candidate", "requires_output_foundations": false, "requires_output_mechanics": false},
      "representative-proof": {"terminal": false, "user_facing_label": "proof for review", "requires_output_foundations": true, "requires_output_mechanics": false},
      "selected-direction": {"terminal": false, "user_facing_label": "selected direction", "requires_output_foundations": true, "requires_output_mechanics": false},
      "production-candidate": {"terminal": false, "user_facing_label": "production candidate", "requires_output_foundations": true, "requires_output_mechanics": true},
      "release-candidate": {"terminal": false, "user_facing_label": "release candidate", "requires_output_foundations": true, "requires_output_mechanics": true},
      "delivered": {"terminal": true, "user_facing_label": "delivered", "requires_output_foundations": true, "requires_output_mechanics": true},
      "rejected": {"terminal": true, "user_facing_label": "rejected; regression evidence only", "requires_output_foundations": false, "requires_output_mechanics": false}
    },
    "release_states": ["delivered"],
    "rejected_states": ["rejected"],
    "transitions": [
      {
        "from": "direction-candidate",
        "to": "representative-proof",
        "requires": ["audience-authenticity", "creative-source"]
      },
      {
        "from": "representative-proof",
        "to": "selected-direction",
        "requires": ["representative-proof", "proof-selection"]
      },
      {
        "from": "selected-direction",
        "to": "production-candidate",
        "requires": ["source-truth", "working-artifact", "rendered-artifact", "native-context"]
      },
      {
        "from": "production-candidate",
        "to": "release-candidate",
        "requires": ["comparative-quality", "independent-critique"]
      },
      {
        "from": "release-candidate",
        "to": "delivered",
        "requires": ["delivery-verification"]
      }
    ],
    "rejection_transition": {
      "from_any_nonterminal": true,
      "to": "rejected",
      "effect": "Invalidate the direction and its visual grammar. Do not repair it through local polish or reuse it as a positive case."
    }
  },
  "flow": [
    {
      "id": "intent",
      "purpose": "Separate final audience from requester and bind the authentic encounter, native medium, artifact class, promise, action, recovery, and truth boundary.",
      "completion": "Audience-authenticity evidence exists and the artifact is a direction-candidate."
    },
    {
      "id": "foundation",
      "purpose": "Recover approved work, select mature benchmarks, and separate the creative foundation of every material layer from assembly mechanics.",
      "completion": "Creative-source evidence exists; custom or generated sources remain candidates until comparative proof."
    },
    {
      "id": "direction",
      "purpose": "Express one project-specific direction as intended-scale proof for the opening, densest moment, and decisive state.",
      "completion": "Representative moments exist in the requested medium or as truthful final-scale artboards."
    },
    {
      "id": "selection",
      "purpose": "Compare representative proof with named mature benchmarks and obtain user approval or an isolated competent comparative decision before scaling.",
      "completion": "Representative-proof and proof-selection evidence move the artifact to selected-direction."
    },
    {
      "id": "production",
      "purpose": "Load only required capability contracts and delegate mechanics after the creative foundation and native artifact class are fixed.",
      "completion": "The complete production-candidate exists with source truth, working/rendered artifact, and native-context evidence."
    },
    {
      "id": "critique",
      "purpose": "Compare the complete artifact positively with mature benchmarks, then remove technical, perceptual, truth, accessibility, rights, and delivery defects.",
      "completion": "No material maturity gap or blocking defect remains and the artifact is a release-candidate."
    },
    {
      "id": "delivery-learning",
      "purpose": "Transition the exact artifact to delivered or rejected, verify delivery truth, and promote only authorized class-level learning.",
      "completion": "The state is truthful; rejection invalidates the direction; any reusable lesson changes future behavior without becoming an anecdotal patch."
    }
  ],
  "evidence_types": {
    "audience-authenticity": "The artifact is authored for the named final audience and encounter. Portfolio, showcase, generation, QA, and production narration stay outside the experience unless that audience genuinely needs them.",
    "creative-source": "The dominant visible or audible language traces to an approved creative foundation distinct from assembly mechanics; custom or generated sources include reference roles and final-scale selection evidence.",
    "representative-proof": "The opening, densest moment, and decisive state exist at intended scale before production.",
    "proof-selection": "The exact representative proof is selected by the user or by an isolated reviewer competent in the medium after comparison with named mature benchmarks; the producing agent cannot self-select it.",
    "comparative-quality": "The complete artifact is compared at intended scale with named mature benchmarks for authorship, specificity, material quality, and medium fit; material inferiority blocks release.",
    "source-truth": "Claims, content, identity, and product behavior trace to authoritative sources.",
    "working-artifact": "The real editable, playable, or native artifact exists and opens in its intended environment.",
    "rendered-artifact": "The actual export/render has been inspected at final-user scale.",
    "interaction-states": "Initial, active, loading, empty, error, success, unavailable, interruption, and recovery states are covered as applicable.",
    "system-overview": "A contact sheet, route matrix, storyboard, page grid, asset overview, or equivalent reveals whole-system coherence.",
    "technical-integrity": "Build, export, decode, schema, dimensions, performance, and format checks pass as applicable.",
    "accessibility": "Perceivability, operability, contrast, focus, text alternatives, reduced motion or sensory alternatives are verified as applicable.",
    "rights-provenance": "Source, license, consent, generation/edit boundary, and redistribution scope are recorded.",
    "independent-critique": "A fresh reviewer who did not produce the artifact, is competent in the medium, and lacks production-process context compares the actual artifact with intent and named benchmarks rather than implementation effort.",
    "delivery-verification": "The exact delivered or published artifact is reopened and its state is distinguished from approval and submission.",
    "native-context": "The artifact runs in or truthfully represents the requested native medium and runtime. A mockup, web facsimile, concept board, or generated scene cannot be classified as an engine, product, deployment, or native artifact.",
    "temporal-continuity": "Timing, transitions, synchronization, loops, and boundary moments remain perceptually continuous.",
    "device-context": "The artifact is checked on representative viewport, display, input, print, playback, or runtime conditions."
  },
  "capabilities": [
