    },
    {
      "id": "sound",
      "contract": "references/capabilities/sound.md",
      "accepts": ["music", "sound-effect", "narration", "sonic-identity", "interactive-audio"],
      "outputs": ["master-audio", "stems", "localized-voice", "integrated-sound-system"],
      "delegates": [
