        {"role": "edit-and-integrate", "candidates": ["daw", "audio-editor", "actual-runtime", "ffmpeg"]}
      ],
      "evidence": ["source-truth", "working-artifact", "technical-integrity", "accessibility", "rights-provenance", "independent-critique", "delivery-verification", "temporal-continuity", "device-context"]
    }
  ],
  "ecosystem": {
